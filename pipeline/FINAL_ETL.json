							"text": "IF OBJECT_ID('wrk.ProductCategory', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.ProductCategory; \nIF OBJECT_ID('wrk.Customer', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.Customer; \nIF OBJECT_ID('wrk.ProductSubcategory', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.ProductSubcategory; \nIF OBJECT_ID('wrk.SalesOrderHeader', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.SalesOrderHeader; \nIF OBJECT_ID('wrk.SalesOrderDetail', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.SalesOrderDetail; \nIF OBJECT_ID('wrk.Store', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.Store; \nIF OBJECT_ID('wrk.SalesTerritory', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.SalesTerritory; \nIF OBJECT_ID('wrk.Person', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.Person;\nIF OBJECT_ID('wrk.pre_fact', 'U') IS NOT NULL \nTRUNCATE TABLE wrk.pre_fact;"

				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "DELETE FROM dw.FactSales; \nDELETE FROM dw.DimTerritory; \nINSERT INTO dw.DimTerritory ( \nTerritoryID, \nTerritoryName, \nCountryRegionCode, \nTerritoryGroup \n) \nSELECT \nTerritoryID, \nName AS TerritoryName, \nCountryRegionCode, \n[Group] AS TerritoryGroup \nFROM stg.SalesTerritory; "
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "FactSales",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "TRUNCATE TABLE dw.FactSales; \nINSERT INTO dw.FactSales \n( \n) \nSalesOrderID, \nSalesOrderDetailID, \nOrderDateKey, \nCustomerKey, \nProductKey, \nTerritoryKey, \nOrderQty, \nUnitPrice, \nUnitPriceDiscount, \nLineTotal \nSELECT \nf.SalesOrderID, \nf.SalesOrderDetailID, \ndd.DateKey, \ndc.CustomerKey, \ndp.ProductKey, \ndt.TerritoryKey, \nf.OrderQty, \nf.UnitPrice, \nf.UnitPriceDiscount, \nf.LineTotal\nFROM wrk.pre_fact f \nLEFT JOIN dw.DimCustomer dc \nON f.CustomerID = dc.CustomerID \nLEFT JOIN dw.DimProduct dp \nON f.ProductID = dp.ProductID \nLEFT JOIN dw.DimDate dd \nON CAST(f.OrderDate AS DATE) = dd.FullDate \nLEFT JOIN dw.DimTerritory dt \nON f.TerritoryID = dt.TerritoryID \nWHERE dc.CustomerKey IS NOT NULL \nAND dp.ProductKey IS NOT NULL \nAND dd.DateKey IS NOT NULL \nAND dt.TerritoryKey IS NOT NULL;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}

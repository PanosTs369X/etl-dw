				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "BEGIN \nIF OBJECT_ID('stg.salesorderheader', 'U') IS NOT NULL \nTRUNCATE TABLE stg.salesorderheader; \nIF OBJECT_ID('stg.salesorderdetail', 'U') IS NOT NULL \nTRUNCATE TABLE stg.salesorderdetail; \nIF OBJECT_ID('stg.customer', 'U') IS NOT NULL \nTRUNCATE TABLE stg.customer; \nIF OBJECT_ID('stg.person', 'U') IS NOT NULL \nTRUNCATE TABLE stg.person; \nIF OBJECT_ID('stg.product', 'U') IS NOT NULL \nTRUNCATE TABLE stg.product; \nIF OBJECT_ID('stg.productsubcategory', 'U') IS NOT NULL \nTRUNCATE TABLE stg.productsubcategory; \nIF OBJECT_ID('stg.productcategory', 'U') IS NOT NULL \nTRUNCATE TABLE stg.productcategory; \nIF OBJECT_ID('stg.salesterritory', 'U') IS NOT NULL \nTRUNCATE TABLE stg.salesterritory; \nIF OBJECT_ID('stg.store', 'U') IS NOT NULL \nTRUNCATE TABLE stg.store; \nEND"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Select_Tables_from_OLTP",
				"type": "Lookup",

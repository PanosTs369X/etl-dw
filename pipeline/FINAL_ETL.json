			{
				"name": "DimCustomer",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Data flow3",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "DELETE FROM dw.DimCustomer; \n \nINSERT INTO dw.DimCustomer ( \n    CustomerID, \n    CustomerType, \n    FirstName, \n    LastName, \n    MiddleName, \n    Age \n) \nSELECT  \n    c.CustomerID, \n    CASE  \n        WHEN c.PersonID IS NOT NULL THEN 'Person' \n        WHEN c.StoreID IS NOT NULL THEN 'Store'\n ELSE 'Unknown' \n    END AS CustomerType, \n    p.First_Name, \n    p.Last_Name, \n    p.Middle_Name, \n    p.Age \nFROM wrk.Customer c \nLEFT JOIN wrk.Person p \n    ON c.PersonID = p.BusinessEntityID;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "DimDate",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Data flow3",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "etl_dw_1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "DELETE FROM dw.FactSales; \nDELETE FROM dw.DimDate; \nWITH DateCTE AS ( \nSELECT CAST('2010-01-01' AS DATE) AS TheDate \nUNION ALL \nSELECT DATEADD(DAY, 1, TheDate) \nFROM DateCTE \nWHERE TheDate < '2030-12-31' \n) \nINSERT INTO dw.DimDate ( \nDateKey, \nFullDate, \nDayNumberOfMonth, \nMonthNumber, \nMonthName, \nQuarterNumber, \nYearNumber \n) \nSELECT \nCAST(FORMAT(TheDate, 'yyyyMMdd') AS INT), \nTheDate, \nDAY(TheDate), \nMONTH(TheDate), \nDATENAME(MONTH, TheDate), \nDATEPART(QUARTER, TheDate), \nYEAR(TheDate) \nFROM DateCTE \nOPTION (MAXRECURSION 0);"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "DimProduct",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Data flow3",
						"dependencyConditions": [
							"Completed"
